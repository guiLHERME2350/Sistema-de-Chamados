rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Verifica se a requisição partiu de um usuário autenticado no Firebase Auth
    function isLogado() {
      return request.auth != null;
    }

    // 2. Papel do usuário (doc users com ID == Auth UID). Com exists() para
    // não quebrar a regra quando o doc ainda não existe (falha fechada).
    function obterRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // ==========================================
    //  REGRAS DE ACESSO POR COLEÇÃO / DOCUMENTO
    // ==========================================

    // [COLEÇÃO: USERS] -> Mapeia perfis, nomes e privilégios de acesso
    match /users/{docId} {
      allow read: if isLogado();
      allow write: if isLogado() && obterRole() == "admin";
    }

    // [DOCUMENTO DE CONFIGURAÇÃO] -> Contador sequencial usado ao abrir chamado.
    // Qualquer logado pode ler/incrementar (senão o `usuario` não abre chamado).
    match /Configurações/Contadorchamados {
      allow read, write: if isLogado();
    }

    // [COLEÇÃO: CHAMADOS] -> Mapeia os tickets de atendimento
    match /chamados/{chamadoId} {
      // Todos os usuários autenticados lêem chamados para alimentar Fila, Kanban e Dashboard
      allow read: if isLogado();

      // Qualquer usuário logado (usuario, tecnico ou admin) tem permissão de abrir um chamado
      allow create: if isLogado()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.status == 'aberto';

      // Alterar status, prioridade, assumir chamado ou mover colunas no Kanban é exclusivo de Técnicos e Admins
      allow update: if isLogado() && (obterRole() == "tecnico" || obterRole() == "admin");

      // A exclusão permanente de chamados é uma ação destrutiva restrita ao Administrador
      allow delete: if isLogado() && obterRole() == "admin";

      // [SUBCOLEÇÃO: MENSAGENS] -> Linha do tempo e chat em tempo real de cada chamado específico
      match /mensagens/{mensagemId} {
        // Usuários comuns, técnicos e administradores participam da leitura e envio no chat
        allow read, create: if isLogado();

        // Editar ou apagar o histórico de mensagens enviadas é permitido apenas para o perfil Administrador
        allow update, delete: if isLogado() && obterRole() == "admin";
      }
    }

  }
}
